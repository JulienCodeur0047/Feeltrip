<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:background="@color/colorPrimary"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imageButtonHome"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:src="@mipmap/home_thin_50px" />
    <ImageView
        android:id="@+id/imageButtonUserGroup"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:src="@mipmap/user_group_men_50px" />
    <ImageView
        android:id="@+id/imageButtonAddCircle"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:src="@mipmap/add_circle_50px" />
    <ImageView
        android:id="@+id/imageButtonNotif"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:src="@mipmap/notification_bell_50px" />
    <ImageView
        android:id="@+id/imageButtonUserSingle"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:src="@mipmap/user_single_50px" />


</LinearLayout>