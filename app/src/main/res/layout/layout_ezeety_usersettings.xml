<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imagebuttonbackProfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:src="@drawable/arrow" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:hint="UserName"
                android:textSize="18dp"
                android:fontFamily="@font/roboto_regular"
                />
        </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/grayscale_background">

    </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:gravity="center">

            <ImageView
                android:layout_width="51dp"
                android:layout_height="match_parent"
                android:src="@drawable/mes_gains" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/textViewbuttonMesgains"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mes gains"
                    android:fontFamily="@font/roboto_bold"
                    android:textSize="18dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Commissions sur vos recommandation réaliser."
                    android:textSize="12dp"
                    android:fontFamily="@font/roboto_regular"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/textViewbuttonChangepsswrd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="50dp"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="Changer mot de passe"
            android:textSize="16dp"
            android:fontFamily="@font/roboto_regular"/>
        <TextView
            android:id="@+id/textViewbuttonCompteAssocies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="50dp"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Compte associés "
            android:textSize="16dp"
            android:fontFamily="@font/roboto_regular"/>
        <TextView
            android:id="@+id/textviewbuttonInviteAmis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="50dp"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="invité des amis"
            android:textSize="16dp"
            android:fontFamily="@font/roboto_regular"/>
        <TextView
            android:id="@+id/textViewbuttonDemandeverif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="50dp"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Demande de vérification "
            android:textSize="16dp"
            android:fontFamily="@font/roboto_regular"/>
        <TextView
            android:id="@+id/textViewbuttonnotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="50dp"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="notification"
            android:textSize="16dp"
            android:fontFamily="@font/roboto_regular"/>
        <TextView
            android:id="@+id/textViewbuttonajouterEtabPro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="50dp"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:text="ajouter votre etablissement professionnel"
            android:textSize="16dp"
            android:fontFamily="@font/roboto_regular"/>
        <TextView
            android:id="@+id/textViewbuttonContecterEzeety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="50dp"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Contacter ezeety"
            android:textSize="16dp"
            android:fontFamily="@font/roboto_regular"/>
        <TextView
            android:id="@+id/textViewbuttonPoilitiqueConfidentialite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="50dp"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Politique de confidentialité "
            android:textSize="16dp"
            android:fontFamily="@font/roboto_regular"/>
        <TextView
            android:id="@+id/textViewbuttonConditionSrv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="50dp"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            android:text="Condition de service"
            android:textSize="16dp"
            android:fontFamily="@font/roboto_regular"/>
        <Button
            android:id="@+id/buttonLogOut"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Déconnexion"
            android:textColor="@color/colorPrimary"
            android:background="@color/colorAccent"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto_regular"
            android:textSize="16dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</android.support.constraint.ConstraintLayout>