<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    tools:ignore="MissingDefaultResource">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/imageviewlogo_description"
            app:srcCompat="@drawable/logo" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/roboto"
            android:text="Inscription"
            android:textColor="@color/colorAccent"/>
        <EditText
            android:id="@+id/edittextNameFirstNameReg"
            style="@style/Widget.AppCompat.EditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/ezeety_edittext_style"
            android:ems="10"
            android:freezesText="true"
            android:hint="Nom et prenom"
            android:inputType="textEmailAddress"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="12dp"/>

        <EditText
            android:id="@+id/editTextUserNamesecondeReg"
            style="@style/Widget.AppCompat.EditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/ezeety_edittext_style"
            android:ems="10"
            android:freezesText="true"
            android:hint="Nom d'utilisateur"
            android:inputType="textEmailAddress"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="12dp"/>
        <EditText
            android:id="@+id/edittextDatenaissanceReg"
            style="@style/Widget.AppCompat.EditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/ezeety_edittext_style"
            android:ems="10"
            android:editable="false"
            android:freezesText="true"
            android:hint="Date de naissance"
            android:inputType="none"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="12dp"/>
        <AutoCompleteTextView
            android:id="@+id/editTextVilleSecondReg"
            style="@style/Widget.AppCompat.EditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/ezeety_edittext_style"
            android:ems="10"
            android:freezesText="true"
            android:hint="Ville"
            android:inputType="textEmailAddress"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="12dp"
            android:textEditSuggestionItemLayout="@layout/layout_ezeety_simple_dropdown_item"
            />

        <Button
            android:id="@+id/buttonNextRegistrationSecond"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/button_style_primary"
            android:text="suivant"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:stateListAnimator="@null"
            />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>